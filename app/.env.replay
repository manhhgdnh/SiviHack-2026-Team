# Offline backend: the recorded Gemini answers in tests/fixtures/replay. No key, no cost.
# Any document that was not recorded ends in a ReplayMiss error (visible in the UI).
# Never put a key in this file: it is committed.
LLM_PROVIDER=replay
USE_CACHE=false            # every call goes through the recordings, never data/cache
LLM_SPLIT_CALLS=true       # the recordings are split-mode prompts
GEMINI_MODEL=gemini-3.8-flash   # the model the recordings were made with (meta.model, cache keys)
