# ---- LLM provider switch ----
# ollama = local test container; remote = provided LLM in prod
LLM_PROVIDER=ollama

# ---- Ollama (test mode) ----
# Inside compose the host is `ollama`; for `uv run` on your machine use http://localhost:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Remote LLM (prod mode) — fill when the key arrives ----
# Any OpenAI-compatible endpoint (OpenRouter / Groq / Gemini OpenAI-compat).
REMOTE_BASE_URL=
REMOTE_API_KEY=
REMOTE_MODEL=

# ---- Ollama context: default 4k would silently truncate the ~4k-token scoring prompt ----
OLLAMA_NUM_CTX=16384

# ---- Output budget / reasoning ----
LLM_TEMPERATURE=0                    # 0 for run-to-run consistency
LLM_MAX_OUTPUT_TOKENS=16384          # thinking tokens count against this on Gemini 2.5; keep it high
LLM_REASONING_EFFORT=low             # scoring calls (OpenAI-compat endpoints; "" = don't send)
LLM_REASONING_EFFORT_COVERAGE=medium # extraction + coverage/violations, where a wrong verdict hurts most
LLM_SPLIT_CALLS=auto                 # auto = split into 2a + 3 parallel groups on remote, one call on ollama; true/false force

# ---- Behaviour ----
DROP_UNGROUNDED=true       # true = drop quotes that cannot be verified (counted in meta); false = keep + flag
USE_CACHE=true             # cache every LLM call on disk (data/cache); weights are never part of the key
