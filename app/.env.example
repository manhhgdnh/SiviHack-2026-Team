# ---- LLM provider switch ----
# gemini = Google Gemini through the google-genai SDK (default); ollama = local test container
LLM_PROVIDER=gemini

# ---- Gemini (default) ----
# Key from Google AI Studio (https://aistudio.google.com/apikey). The only value without a default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Ollama (offline test mode: LLM_PROVIDER=ollama) ----
# Inside compose the host is `ollama`; for `uv run` on your machine use http://localhost:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
# Ollama context: default 4k would silently truncate the ~4k-token scoring prompt
OLLAMA_NUM_CTX=16384

# ---- Output budget / reasoning ----
LLM_TEMPERATURE=0                    # 0 for run-to-run consistency
LLM_MAX_OUTPUT_TOKENS=16384          # thinking tokens count against this on Gemini; keep it high
LLM_REASONING_EFFORT=low             # Gemini thinking level for scoring calls (minimal/low/medium/high; "" = model default)
LLM_REASONING_EFFORT_COVERAGE=medium # extraction + coverage/violations, where a wrong verdict hurts most
LLM_SPLIT_CALLS=auto                 # auto = split into 2a + 3 parallel groups on gemini, one call on ollama; true/false force

# ---- Behaviour ----
DROP_UNGROUNDED=true       # true = drop quotes that cannot be verified (counted in meta); false = keep + flag
USE_CACHE=true             # cache every LLM call on disk (data/cache); weights are never part of the key

# ---- Spend guard ----
LLM_BUDGET_USD=5           # all-time total of data/usage.csv on this machine; blank = unlimited

# ---- Recording / replay (tests, offline UI work; see tests/record_fixtures.py) ----
# LLM_PROVIDER=replay      # serve tests/fixtures/replay, never the network (see .env.replay)
# LLM_RECORD_DIR=tests/fixtures/replay   # wrap the real provider and record every miss
# LLM_REPLAY_FAIL=coverage # replay only: make this call kind answer invalid JSON (partial result)
# LLM_REPLAY_DELAY_MS=1500 # replay only: slow each call down to watch the run trace

# ---- Logging ----
LOG_LEVEL=INFO             # INFO follows every run (calls, cache hits, grounding, cost); DEBUG adds prompt heads and answers
