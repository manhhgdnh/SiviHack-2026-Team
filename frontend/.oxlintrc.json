{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "Use the client in src/api/client.ts. One client means one place to add headers, retries and error handling."
      },
      {
        "name": "XMLHttpRequest",
        "message": "Use the client in src/api/client.ts."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/api/client.ts",
        "src/api/stream.ts"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ],
  "ignorePatterns": [
    "src/api/generated/**"
  ]
}
